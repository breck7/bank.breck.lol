// Parsers for the starter transactions at the top of readme.scroll.
// Each transaction is a ScrollSet concept that starts with a "type" line.
// The lines print nothing on the page; buildConcepts turns them into bankSeed.json.
abstractTxMeasureParser
 extends abstractStringMeasureParser
 javascript
  buildHtml() { return "" }
txTypeParser
 cue type
 extends abstractTxMeasureParser
 description Transaction type: openAccount, friend, card, deposit, transfer, send, loan, payment, interest, name...
 float sortIndex 1
 boolean isMeasureRequired true
 boolean isConceptDelimiter true
