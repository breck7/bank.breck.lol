   id detail-body

div
 addClass toast
 id toast

script
 (function () {
  "use strict";
  // ============================================================
  // Bank of Breck — a front-end-only bank.
  // All state lives in localStorage. There is no server.
  // To add a backend later, keep these shapes and replace the
  // Backend adapter below with fetch() calls to your own API.
  // ============================================================
  const STORAGE_KEY = "bankOfBreck.v1";
  const DAY = 86400000;
  const $ = (sel, root) => (root || document).querySelector(sel);
  const $$ = (sel, root) => Array.from((root || document).querySelectorAll(sel));
  const round2 = n => Math.round((Number(n) || 0) * 100) / 100;
  const digits = n => Array.from({ length: n }, () => Math.floor(Math.random() * 10)).join("");
  const uid = p => (p || "id") + "_" + Math.random().toString(36).slice(2, 8) + Date.now().toString(36).slice(-4);
  const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
  const money = n => usd.format(Number(n) || 0);
  const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const initials = name => String(name || "?").trim().split(/\s+/).slice(0, 2).map(w => w[0]).join("").toUpperCase();
  const label = t => (t === "savings" ? "Savings" : "Checking");
  const maskCard = num => "•••• •••• •••• " + String(num).slice(-4);
  // ===== Backend adapter: swap this for fetch() to go serverful =====
  const Backend = {
   load() { try { const raw = localStorage.getItem(STORAGE_KEY); return raw ? JSON.parse(raw) : null; } catch (e) { return null; } },
   save(s) { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch (e) {} }
  };
  // ===== Seed data =====
  function seed() {
   const now = Date.now();
   const checking = { id: uid("acct"), name: "Everyday Checking", type: "checking", number: digits(4), balance: 4820.55, rate: 0.001, createdAt: now - 42 * DAY, lastAccrued: now };
   const savings = { id: uid("acct"), name: "High-Yield Savings", type: "savings", number: digits(4), balance: 12000, rate: 0.0425, createdAt: now - 140 * DAY, lastAccrued: now - 6 * DAY };
   const friends = [
    { id: uid("fr"), name: "Alex Rivera", handle: "@alex", color: "#3d6fd6" },
    { id: uid("fr"), name: "Sam Chen", handle: "@sam", color: "#0d9f6e" },
    { id: uid("fr"), name: "Jordan Lee", handle: "@jordan", color: "#c2703d" },
    { id: uid("fr"), name: "Priya Patel", handle: "@priya", color: "#7c5cd6" }
   ];
   const transactions = [
    { id: uid("tx"), ts: now - 42 * DAY, kind: "deposit", amount: 4820.55, to: checking.id, note: "Opening deposit" },
    { id: uid("tx"), ts: now - 20 * DAY, kind: "deposit", amount: 12000, to: savings.id, note: "Opening deposit" },
    { id: uid("tx"), ts: now - 3 * DAY, kind: "send", amount: 42.5, from: checking.id, to: friends[0].id, note: "Dinner" }
   ];
   return { version: 1, holder: "Breck", accounts: [checking, savings], friends, loans: [], cards: [], transactions, settings: {} };
  }
  let state = Backend.load() || seed();
  // ===== Model helpers =====
  const getAccount = id => state.accounts.find(a => a.id === id);
  const getFriend = id => state.friends.find(f => f.id === id);
  const getLoan = id => state.loans.find(l => l.id === id);
  const getCard = id => state.cards.find(c => c.id === id);
  const accountName = id => { const a = getAccount(id); return a ? a.name : "External"; };
  const friendName = id => { const f = getFriend(id); return f ? f.name : "External"; };
  function addTx(t) { state.transactions.unshift(Object.assign({ id: uid("tx"), ts: Date.now() }, t)); state.transactions = state.transactions.slice(0, 200); }
  function accruedInterest(a, now) {
   if (a.type !== "savings") return 0;
   const since = a.lastAccrued || a.createdAt || now;
   const days = Math.max(0, (now - since) / DAY);
   return round2(a.balance * (a.rate || 0) * days / 365);
  }
  function totalAccrued() { const now = Date.now(); return round2(state.accounts.reduce((s, a) => s + accruedInterest(a, now), 0)); }
  function loanApr(amount, term) {
   const base = 0.059;
   const size = Math.min(0.06, (Number(amount) || 0) / 50000 * 0.02);
   const termAdj = term >= 48 ? 0.012 : term <= 12 ? -0.004 : 0;
   return Math.max(0.039, base + size + termAdj);
  }
  function monthlyPayment(l) {
   const r = (l.apr || 0) / 12, n = l.termMonths || 12;
   if (!r) return l.principal / n;
   return l.principal * r / (1 - Math.pow(1 + r, -n));
  }
  // ===== Mutations: return an error string, or null on success =====
  function doTransfer(fromId, toId, amount, note) {
   const from = getAccount(fromId), to = getAccount(toId);
   if (!from || !to) return "Choose two accounts";
   if (from.id === to.id) return "Pick two different accounts";
   amount = round2(amount);
   if (!(amount > 0)) return "Enter an amount greater than zero";
   if (from.balance < amount) return "Not enough money in " + from.name;
   from.balance = round2(from.balance - amount);
   to.balance = round2(to.balance + amount);
   addTx({ kind: "transfer", amount, from: from.id, to: to.id, note: note || "Transfer" });
   return null;
  }
  function doSend(fromId, friendId, amount, note) {
   const from = getAccount(fromId), friend = getFriend(friendId);
   if (!from) return "Choose an account";
   if (!friend) return "Choose a friend";
   amount = round2(amount);
   if (!(amount > 0)) return "Enter an amount greater than zero";
   if (from.balance < amount) return "Not enough money in " + from.name;
   from.balance = round2(from.balance - amount);
   addTx({ kind: "send", amount, from: from.id, to: friend.id, note: note || ("To " + friend.name) });
   return null;
  }
  function doPayLoan(loanId, accountId, amount) {
   const loan = getLoan(loanId), acc = getAccount(accountId);
   if (!loan) return "Loan not found";
   if (loan.status === "paid") return "This loan is already paid off";
   if (!acc) return "Choose an account";
   amount = round2(amount);
   if (!(amount > 0)) return "Enter a payment amount";
   const pay = Math.min(amount, loan.balance);
   if (acc.balance < pay) return "Not enough money in " + acc.name;
   acc.balance = round2(acc.balance - pay);
   loan.balance = round2(loan.balance - pay);
   loan.payments.push({ ts: Date.now(), amount: pay });
   if (loan.balance <= 0.005) { loan.balance = 0; loan.status = "paid"; }
   addTx({ kind: "payment", amount: pay, from: acc.id, to: loan.id, note: "Payment · " + loan.name });
   return null;
  }
  // ===== Toast + commit =====
  let toastTimer = null, pendingUndo = null;
  function toast(message, undo) {
   const t = $("#toast");
   t.innerHTML = "<span>" + esc(message) + "</span>" + (undo ? '<button data-action="toast-undo">' + esc(undo.label || "Undo") + "</button>" : "");
   pendingUndo = undo || null;
   t.classList.add("show");
   clearTimeout(toastTimer);
   toastTimer = setTimeout(() => { t.classList.remove("show"); pendingUndo = null; }, undo ? 6000 : 2600);
  }
  const fail = message => toast(message);
  function commit(message, undo) { Backend.save(state); render(); renderInterest(); if (message) toast(message, undo); }
  function runUndo() { if (pendingUndo) { pendingUndo.fn(); pendingUndo = null; } }
  // ===== Rendering =====
  const empty = text => '<div class="empty">' + esc(text) + "</div>";
  function renderTotals() {
   const cash = round2(state.accounts.reduce((s, a) => s + a.balance, 0));
   const owed = round2(state.loans.reduce((s, l) => s + l.balance, 0));
   $("#total-balance").textContent = money(cash);
   $("#net-worth").textContent = money(cash - owed);
   $("#stat-available").textContent = money(cash);
   $("#stat-owed").textContent = money(owed);
   $("#stat-accounts").textContent = state.accounts.length;
  }
  function renderInterest() { const el = $("#interest-pending"); if (el) el.textContent = money(totalAccrued()); }
  function renderAccounts() {
   const grid = $("#accounts-grid"), count = $("#accounts-count");
   if (count) count.textContent = state.accounts.length + (state.accounts.length === 1 ? " account" : " accounts");
   if (!state.accounts.length) { grid.innerHTML = empty("No accounts yet. Open your first one."); return; }
   grid.innerHTML = state.accounts.map(a => {
    const gain = accruedInterest(a, Date.now());
    return '<article class="account ' + a.type + '">' +
     '<div class="acct-top"><div><div class="acct-name">' + esc(a.name) + '</div><div class="acct-num">' + label(a.type) + " •• " + a.number + '</div></div><span class="pill ' + a.type + '">' + label(a.type) + "</span></div>" +
     '<div class="acct-bal">' + money(a.balance) + "</div>" +
     (gain > 0.01 ? '<div class="acct-interest">+' + money(gain) + " interest ready</div>" : "") +
     '<div class="acct-actions"><a class="btn small" href="#transfer?from=' + a.id + '">Transfer</a><a class="btn small" href="#deposit?account=' + a.id + '">Add</a><a class="btn ghost small" href="#account/' + a.id + '">Details</a></div>' +
     "</article>";
   }).join("");
  }
  function renderCards() {
   const grid = $("#cards-grid"), count = $("#cards-count");
   const active = state.cards.filter(c => c.status === "active").length;
   if (count) count.textContent = active + " active";
   if (!state.cards.length) { grid.innerHTML = empty("Create a virtual card for any budget, store, or subscription."); return; }
   grid.innerHTML = state.cards.map(c =>
    '<article class="vcard' + (c.status === "canceled" ? " canceled" : "") + '" style="background:' + c.gradient + '">' +
     '<a class="vcard-link" href="#card/' + c.id + '">' +
      '<div class="vc-top"><div><div class="vc-nick">' + esc(c.nickname) + '</div><div class="vc-kind">Virtual · ' + (c.status === "canceled" ? "Canceled" : "Active") + '</div></div><span class="vc-chip"></span></div>' +
      '<div class="vc-num">' + maskCard(c.number) + "</div>" +
      '<div class="vc-bottom"><span class="vc-limit">Limit ' + money(c.limit) + "/mo</span></div>" +
     "</a>" +
     (c.status === "active" ? '<button class="vc-cancel" data-action="cancel-card" data-card="' + c.id + '">Cancel</button>' : '<span class="vc-canceled">Canceled</span>') +
    "</article>"
   ).join("");
  }
  function renderLoans() {
   const list = $("#loans-list");
   if (!state.loans.length) { list.innerHTML = empty("No loans. Apply and get an instant decision."); return; }
   list.innerHTML = state.loans.map(l => {
    const paid = round2(l.principal - l.balance);
    const pct = Math.min(100, (paid / l.principal) * 100);
    const monthly = monthlyPayment(l);
    return '<a class="loan" href="#loan/' + l.id + '">' +
     '<div class="loan-top"><div><div class="loan-name">' + esc(l.name) + '</div><div class="loan-meta">' + (l.apr * 100).toFixed(1) + "% APR · " + l.termMonths + " mo" + (l.status === "paid" ? " · Paid off" : "") + '</div></div><div class="loan-bal">' + money(l.balance) + "</div></div>" +
     '<div class="progress"><span style="width:' + pct + '%"></span></div>' +
     '<div class="loan-foot"><span>' + money(paid) + ' paid</span><span>' + (l.status === "paid" ? "Settled" : money(monthly) + "/mo") + "</span></div>" +
     "</a>";
   }).join("");
  }
  function renderFriends() {
   $("#friends-list").innerHTML = state.friends.map(f =>
    '<div class="friend"><span class="avatar" style="background:' + f.color + '">' + initials(f.name) + '</span><div class="friend-main"><div class="friend-name">' + esc(f.name) + '</div><div class="friend-handle">' + esc(f.handle) + '</div></div><a class="btn small" href="#send?to=' + f.id + '">Send</a></div>'
   ).join("") || empty("No friends yet.");
  }
  function txMeta(t) {
   if (t.kind === "send") return { icon: "↗", desc: "Sent to " + friendName(t.to) + (t.note ? " · " + t.note : ""), sign: -1 };
   if (t.kind === "transfer") return { icon: "⇄", desc: "Transfer · " + (t.note || accountName(t.to)), sign: 0 };
   if (t.kind === "interest") return { icon: "%", desc: "Interest · " + accountName(t.to), sign: 1 };
   if (t.kind === "loan") return { icon: "+", desc: "Loan disbursed · " + (t.note || "Loan"), sign: 1 };
   if (t.kind === "payment") return { icon: "✓", desc: t.note || "Loan payment", sign: -1 };
   if (t.kind === "card") return { icon: "▭", desc: t.note || "Virtual card", sign: 0 };
   if (t.kind === "deposit") return { icon: "↓", desc: t.note || ("Deposit · " + accountName(t.to)), sign: 1 };
   return { icon: "•", desc: t.note || t.kind, sign: 1 };
  }
  function timeAgo(ts) {
   const s = (Date.now() - ts) / 1000;
   if (s < 60) return "just now";
   if (s < 3600) return Math.floor(s / 60) + "m ago";
   if (s < 86400) return Math.floor(s / 3600) + "h ago";
   if (s < 604800) return Math.floor(s / 86400) + "d ago";
   return new Date(ts).toLocaleDateString("en-US", { month: "short", day: "numeric" });
  }
  function renderActivity() {
   const list = $("#activity-list");
   if (!state.transactions.length) { list.innerHTML = empty("No activity yet. Try a transfer or a deposit."); return; }
   list.innerHTML = state.transactions.slice(0, 30).map(t => {
    const m = txMeta(t);
    const amt = m.sign === 0 ? '<span class="tx-amt muted">—</span>' : '<span class="tx-amt ' + (m.sign > 0 ? "pos" : "neg") + '">' + (m.sign > 0 ? "+" : "−") + money(Math.abs(t.amount)) + "</span>";
    return '<div class="tx"><span class="tx-ico">' + m.icon + '</span><div class="tx-main"><div class="tx-desc">' + esc(m.desc) + '</div><div class="tx-time">' + timeAgo(t.ts) + "</div></div>" + amt + "</div>";
   }).join("");
  }
  function render() { renderTotals(); renderAccounts(); renderCards(); renderLoans(); renderFriends(); renderActivity(); }
  function renderGreeting() {
   const h = new Date().getHours();
   const part = h < 5 ? "Up late" : h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
   const el = $("#greeting");
   if (el) el.textContent = part + ", " + state.holder + ".";
  }
  // ===== Selects + prefill =====
  function accountOptions(selected) {
   return state.accounts.map(a => '<option value="' + a.id + '"' + (a.id === selected ? " selected" : "") + ">" + esc(a.name) + " · " + money(a.balance) + "</option>").join("");
  }
  function friendOptions(selected) {
   return state.friends.map(f => '<option value="' + f.id + '"' + (f.id === selected ? " selected" : "") + ">" + esc(f.name) + " " + esc(f.handle) + "</option>").join("");
  }
  const setVal = (id, v) => { const el = document.getElementById(id); if (el && v != null && v !== "") el.value = v; };
  function populate(name, opts) {
   opts = opts || {};
   if (name === "transfer") {
    $("#transfer-from").innerHTML = accountOptions(opts.from || (state.accounts[0] && state.accounts[0].id));
    $("#transfer-to").innerHTML = accountOptions(opts.to || (state.accounts[1] && state.accounts[1].id));
    setVal("transfer-amount", opts.amount); setVal("transfer-note", opts.note);
   }
   if (name === "send") {
    $("#send-from").innerHTML = accountOptions(opts.from || (state.accounts[0] && state.accounts[0].id));
    $("#send-friend").innerHTML = friendOptions(opts.to);
    setVal("send-amount", opts.amount); setVal("send-note", opts.note);
   }
   if (name === "deposit") {
    $("#deposit-account").innerHTML = accountOptions(opts.account || (state.accounts[0] && state.accounts[0].id));
    setVal("deposit-amount", opts.amount);
   }
  }
  // ===== Modals =====
  function closeModals() { $$(".modal.open").forEach(m => m.classList.remove("open")); }
  function clearHash() { if (location.hash) history.replaceState(null, "", location.pathname + location.search); }
  function closeAndClear() { closeModals(); clearHash(); }
  function openModal(name, opts) {
   closeModals();
   const el = document.getElementById("modal-" + name);
   if (!el) return;
   const form = el.querySelector("form");
   if (form) form.reset();
   populate(name, opts);
   if (name === "apply-loan") updateLoanPreview();
   el.classList.add("open");
   const field = el.querySelector("input:not([type=hidden]), select");
   if (field) setTimeout(() => field.focus(), 40);
  }
  function setActiveNav(name) { $$("[data-nav]").forEach(a => a.classList.toggle("active", a.dataset.nav === name)); }
  // ===== Detail views =====
  function openAccountDetail(id) {
   const a = getAccount(id);
   if (!a) return;
   $("#detail-title").textContent = a.name;
   $("#detail-body").innerHTML =
    '<div class="detail-hero"><span class="k">Balance</span><div class="detail-big">' + money(a.balance) + '</div><div class="muted">' + label(a.type) + " •• " + a.number + (a.type === "savings" ? " · " + (a.rate * 100).toFixed(2) + "% APY" : "") + "</div></div>" +
    '<div class="detail-actions"><a class="btn small" href="#transfer?from=' + a.id + '">Transfer out</a><a class="btn small" href="#deposit?account=' + a.id + '">Add money</a>' + (a.balance < 0.01 ? '<button class="btn danger small" data-action="close-account" data-account="' + a.id + '">Close account</button>' : "") + "</div>";
   openModal("detail");
  }
  function openCardDetail(id) {
   const c = getCard(id);
   if (!c) return;
   $("#detail-title").textContent = c.nickname;
   $("#detail-body").innerHTML =
    '<div class="bigcard" style="background:' + c.gradient + '"><div class="vc-top"><div><div class="vc-nick">' + esc(c.nickname) + '</div><div class="vc-kind">Virtual card</div></div><span class="vc-chip"></span></div><div class="vc-num">' + maskCard(c.number) + '</div><div class="vc-bottom"><span>EXP ' + c.expiry + '</span><span>CVV ' + c.cvv + '</span><span>Limit ' + money(c.limit) + "/mo</span></div></div>" +
    '<div class="detail-actions">' + (c.status === "active" ? '<button class="btn danger" data-action="cancel-card" data-card="' + c.id + '">Cancel card</button>' : '<span class="pill">Canceled</span>') + '<button class="btn ghost" data-action="close">Close</button></div>';
   openModal("detail");
  }
  function openLoanDetail(id) {
   const l = getLoan(id);
   if (!l) return;
   const paid = round2(l.principal - l.balance);
   const pct = Math.min(100, (paid / l.principal) * 100);
   const monthly = monthlyPayment(l);
   $("#detail-title").textContent = l.name;
   $("#detail-body").innerHTML =
    '<div class="detail-hero"><span class="k">Remaining balance</span><div class="detail-big">' + money(l.balance) + '</div><div class="muted">' + (l.apr * 100).toFixed(1) + "% APR · " + l.termMonths + " months · " + money(monthly) + "/mo</div></div>" +
    '<div class="progress"><span style="width:' + pct + '%"></span></div>' +
    (l.status === "paid"
     ? '<div class="paid-note">This loan is paid off. Nice work.</div><div class="modal-actions inline"><button class="btn ghost" data-action="close">Close</button></div>'
     : '<form data-form="pay-loan"><input type="hidden" id="pay-loan-id" value="' + l.id + '"><div class="field"><label for="pay-account">Pay from</label><select id="pay-account">' + accountOptions() + '</select></div><div class="field"><label for="pay-amount">Payment amount</label><input id="pay-amount" type="number" min="0.01" step="0.01" value="' + monthly.toFixed(2) + '"></div><div class="modal-actions inline"><button class="btn ghost" type="button" data-action="close">Close</button><button class="btn primary" type="submit">Make payment</button></div></form>');
   openModal("detail");
  }
  // ===== Forms =====
  const val = id => { const el = document.getElementById(id); return el ? el.value : ""; };
  function updateLoanPreview() {
   const el = $("#loan-preview");
   if (!el) return;
   const amount = round2(parseFloat(val("loan-amount")) || 0);
   const term = parseInt(val("loan-term")) || 24;
   if (!(amount > 0)) { el.innerHTML = "Enter an amount to see your rate."; return; }
   const apr = loanApr(amount, term);
   const r = apr / 12;
   const monthly = amount * r / (1 - Math.pow(1 + r, -term));
   el.innerHTML = "Estimated <strong>" + (apr * 100).toFixed(1) + "% APR</strong> · <strong>" + money(monthly) + "/mo</strong> for " + term + " months";
  }
  function handleForm(name, form) {
   if (name === "new-account") {
    const type = val("account-type");
    const nm = val("account-name").trim() || (type === "savings" ? "Savings" : "Checking");
    const opening = round2(parseFloat(val("account-opening")) || 0);
    const acc = { id: uid("acct"), name: nm, type, number: digits(4), balance: opening, rate: type === "savings" ? 0.0425 : 0.001, createdAt: Date.now(), lastAccrued: Date.now() };
    state.accounts.push(acc);
    if (opening > 0) addTx({ kind: "deposit", amount: opening, to: acc.id, note: "Opening deposit · " + nm });
    commit("Opened " + nm + " with " + money(opening));
    return closeAndClear();
   }
   if (name === "transfer") {
    const err = doTransfer(val("transfer-from"), val("transfer-to"), parseFloat(val("transfer-amount")), val("transfer-note").trim());
    if (err) return fail(err);
    commit("Transferred " + money(parseFloat(val("transfer-amount"))));
    return closeAndClear();
   }
   if (name === "send") {
    const friend = getFriend(val("send-friend"));
    const err = doSend(val("send-from"), val("send-friend"), parseFloat(val("send-amount")), val("send-note").trim());
    if (err) return fail(err);
    commit("Sent " + money(parseFloat(val("send-amount"))) + " to " + (friend ? friend.name : "friend"));
    return closeAndClear();
   }
   if (name === "deposit") {
    const acc = getAccount(val("deposit-account"));
    const amount = round2(parseFloat(val("deposit-amount")));
    if (!acc) return fail("Choose an account");
    if (!(amount > 0)) return fail("Enter an amount");
    acc.balance = round2(acc.balance + amount);
    addTx({ kind: "deposit", amount, to: acc.id, note: "Deposit · " + acc.name });
    commit("Added " + money(amount) + " to " + acc.name);
    return closeAndClear();
   }
   if (name === "apply-loan") {
    const amount = round2(parseFloat(val("loan-amount")));
    const term = parseInt(val("loan-term")) || 24;
    const purpose = val("loan-purpose").trim() || "Personal loan";
    if (!(amount > 0)) return fail("Enter a loan amount");
    const apr = loanApr(amount, term);
    const dest = state.accounts.find(a => a.type === "checking") || state.accounts[0];
    const loan = { id: uid("loan"), name: purpose, principal: amount, apr, termMonths: term, balance: amount, status: "active", createdAt: Date.now(), payments: [] };
    state.loans.push(loan);
    if (dest) dest.balance = round2(dest.balance + amount);
    addTx({ kind: "loan", amount, to: dest ? dest.id : null, note: purpose + " · " + (apr * 100).toFixed(1) + "% APR" });
    commit("Approved " + money(amount) + " at " + (apr * 100).toFixed(1) + "% APR");
    return closeAndClear();
   }
   if (name === "new-card") {
    const nick = val("card-nickname").trim() || "Virtual card";
    const limit = round2(parseFloat(val("card-limit")) || 500);
    const gradient = GRADIENTS[parseInt(val("card-color")) % GRADIENTS.length];
    const card = { id: uid("card"), nickname: nick, number: digits(16), expiry: expDate(), cvv: digits(3), limit, status: "active", createdAt: Date.now(), gradient, spent: 0 };
    state.cards.push(card);
    addTx({ kind: "card", amount: 0, to: card.id, note: 'Created card "' + nick + '"' });
    commit('Card "' + nick + '" is ready to use');
    return closeAndClear();
   }
   if (name === "pay-loan") {
    const loanId = val("pay-loan-id");
    const err = doPayLoan(loanId, val("pay-account"), parseFloat(val("pay-amount")));
    if (err) return fail(err);
    commit("Payment made");
    return openLoanDetail(loanId);
   }
  }
  // ===== Gradients + dates =====
  const GRADIENTS = ["linear-gradient(135deg,#0f766e,#0d9f6e)", "linear-gradient(135deg,#1e293b,#0f172a)", "linear-gradient(135deg,#b45309,#f59e0b)", "linear-gradient(135deg,#6d28d9,#8b5cf6)", "linear-gradient(135deg,#1d4ed8,#3b82f6)", "linear-gradient(135deg,#9f1239,#ef4444)", "linear-gradient(135deg,#0e7490,#06b6d4)"];
  function expDate() { const d = new Date(); d.setFullYear(d.getFullYear() + 3); return String(d.getMonth() + 1).padStart(2, "0") + "/" + String(d.getFullYear()).slice(-2); }
  // ===== Actions =====
  function collectInterest() {
   const now = Date.now();
   let total = 0;
   state.accounts.forEach(a => {
    if (a.type !== "savings") return;
    const amt = accruedInterest(a, now);
    if (amt > 0) { a.balance = round2(a.balance + amt); total = round2(total + amt); addTx({ kind: "interest", amount: amt, to: a.id, note: "Interest · " + a.name }); }
    a.lastAccrued = now;
   });
   if (!total) return fail("No interest to collect yet");
   commit("Collected " + money(total) + " in interest");
  }
  function cancelCard(id) {
   const c = getCard(id);
   if (!c || c.status !== "active") return;
   c.status = "canceled";
   addTx({ kind: "card", amount: 0, to: c.id, note: 'Canceled card "' + c.nickname + '"' });
   Backend.save(state); render();
   if ($("#modal-detail").classList.contains("open")) openCardDetail(id);
   toast('Canceled "' + c.nickname + '"', { label: "Undo", fn: () => { c.status = "active"; Backend.save(state); render(); toast('Restored "' + c.nickname + '"'); } });
  }
  function closeAccount(id) {
   const a = getAccount(id);
   if (!a) return;
   if (a.balance > 0.01) return fail("Move the money out first");
   const idx = state.accounts.indexOf(a);
   state.accounts.splice(idx, 1);
   Backend.save(state); render(); closeAndClear();
   toast("Closed " + a.name, { label: "Undo", fn: () => { state.accounts.splice(idx, 0, a); Backend.save(state); render(); } });
  }
  function clearActivity() { state.transactions = []; commit("Activity cleared"); }
  function resetAll() {
   if (!confirm("Reset Bank of Breck and erase all local data?")) return;
   state = seed(); Backend.save(state); render(); renderInterest(); closeAndClear(); toast("Fresh start");
  }
  // ===== Routing: deep links for every view =====
  function parseHash() {
   const raw = location.hash.replace(/^#\/?/, "");
   const qi = raw.indexOf("?");
   const path = qi >= 0 ? raw.slice(0, qi) : raw;
   const query = qi >= 0 ? raw.slice(qi + 1) : "";
   const params = {};
   query.split("&").filter(Boolean).forEach(pair => {
    const i = pair.indexOf("=");
    const k = decodeURIComponent(i >= 0 ? pair.slice(0, i) : pair);
    const v = i >= 0 ? decodeURIComponent(pair.slice(i + 1)) : "";
    params[k] = v;
   });
   const parts = path.split("/").filter(Boolean);
   return { path: parts[0] || "", arg: parts[1] || "", params };
  }
  function route() {
   const r = parseHash();
   const sections = { dashboard: "top", accounts: "sec-accounts", cards: "sec-cards", loans: "sec-loans", friends: "sec-friends", activity: "sec-activity" };
   const p = r.path === "" ? "dashboard" : r.path;
   if (Object.prototype.hasOwnProperty.call(sections, p)) {
    closeModals();
    setActiveNav(p);
    if (p === "dashboard") window.scrollTo({ top: 0, behavior: "smooth" });
    else { const el = document.getElementById(sections[p]); if (el) el.scrollIntoView({ behavior: "smooth", block: "start" }); }
    return;
   }
   setActiveNav("");
   if (p === "new-account") return openModal("new-account");
   if (p === "apply-loan") return openModal("apply-loan");
   if (p === "new-card") return openModal("new-card");
   if (p === "transfer") return openModal("transfer", r.params);
   if (p === "send") return openModal("send", r.params);
   if (p === "deposit") return openModal("deposit", r.params);
   if (p === "account" && r.arg) return openAccountDetail(r.arg);
   if (p === "card" && r.arg) return openCardDetail(r.arg);
   if (p === "loan" && r.arg) return openLoanDetail(r.arg);
   closeModals();
  }
  // ===== Events =====
  document.addEventListener("submit", e => {
   const form = e.target.closest("form[data-form]");
   if (!form) return;
   e.preventDefault();
   handleForm(form.getAttribute("data-form"), form);
  });
  document.addEventListener("click", e => {
   const el = e.target.closest("[data-action]");
   if (el) {
    const action = el.getAttribute("data-action");
    if (action === "cancel-card") { e.preventDefault(); e.stopPropagation(); return cancelCard(el.getAttribute("data-card")); }
    if (action === "close-account") { e.preventDefault(); return closeAccount(el.getAttribute("data-account")); }
    if (action === "interest") { e.preventDefault(); return collectInterest(); }
    if (action === "toast-undo") { e.preventDefault(); return runUndo(); }
    if (action === "reset") { e.preventDefault(); return resetAll(); }
    if (action === "clear-activity") { e.preventDefault(); return clearActivity(); }
    if (action === "close") { e.preventDefault(); return closeAndClear(); }
   }
   if (e.target.classList && e.target.classList.contains("modal")) closeAndClear();
  });
  document.addEventListener("keydown", e => { if (e.key === "Escape") closeAndClear(); });
  window.addEventListener("hashchange", route);
  window.addEventListener("storage", e => { if (e.key === STORAGE_KEY) { state = Backend.load() || state; render(); renderInterest(); } });
  ["loan-amount", "loan-term"].forEach(id => { const el = document.getElementById(id); if (el) { el.addEventListener("input", updateLoanPreview); el.addEventListener("change", updateLoanPreview); } });
  // ===== Boot =====
  renderGreeting();
  render();
  renderInterest();
  route();
  setInterval(renderInterest, 1000);
  // Expose a tiny API so a backend can be added later without touching the UI.
  window.BankOfBreck = { get state() { return state; }, Backend, render };
 })();
