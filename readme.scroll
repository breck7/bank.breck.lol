permalink index.html
buildHtml
title Bank of Breck — your friendly virtual bank
description Bank of Breck is a front-end-only bank. Open unlimited checking and savings accounts, transfer money, send to friends, earn interest, apply for and pay off loans, and spin up unlimited virtual cards with nicknames you can cancel in one click. Everything is stored locally in your browser.
canonicalUrl https://bank.breck.lol/
openGraphImage https://bank.breck.lol/og.png
favicon favicon.svg
keywords bank, virtual bank, checking, savings, loans, virtual cards, ScrollSet, front-end
metaTags

css
 /* ===== tokens ===== */
 :root{--bg:#f1f0e9;--surface:#fffefb;--surface-2:#f8f7f1;--ink:#13221c;--muted:#626f68;--line:#e3e3d8;--line-2:#d3d5c7;--accent:#0d9f6e;--accent-dark:#0a7c55;--accent-soft:#e2f5ec;--blue:#3d6fd6;--blue-soft:#e8eefc;--amber:#b8860b;--amber-soft:#f8efd7;--danger:#d64545;--danger-soft:#fbe8e6;--radius:18px;--shadow:0 1px 2px rgba(19,34,28,.05),0 18px 40px -24px rgba(19,34,28,.4);--mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,monospace;--serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color-scheme:light}
 /* ===== base ===== */
 *{box-sizing:border-box}
 html{scroll-behavior:smooth}
 body{margin:0;background:radial-gradient(1100px 480px at 82% -12%,#e4f6ee 0,transparent 62%),var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
 a{color:inherit;text-decoration:none}
 button,input,select{font:inherit;color:inherit}
 button{cursor:pointer;background:none;border:none}
 h1,h2,h3{margin:0;letter-spacing:-.02em}
 p{margin:0}
 ::selection{background:#c9f0df}
 :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:8px}
 .muted{color:var(--muted)}
 .wrap{width:min(1160px,100% - 36px);margin-inline:auto}
 section[id]{scroll-margin-top:84px}
 /* ===== topbar ===== */
 .topbar{position:sticky;top:0;z-index:40;background:rgba(241,240,233,.86);border-bottom:1px solid var(--line)}
 .topbar::before{content:"";position:absolute;inset:0;z-index:-1;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
 .topbar-inner{display:flex;align-items:center;gap:20px;height:64px}
 .brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:-.03em;font-size:17px;white-space:nowrap}
 .brand-mark{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:linear-gradient(150deg,var(--accent),var(--accent-dark));color:#fff;font-family:var(--serif);font-size:17px;box-shadow:0 8px 16px -8px rgba(13,159,110,.9)}
 .navlinks{display:flex;gap:2px;margin-left:6px}
 .navlinks a{padding:8px 12px;border-radius:999px;color:var(--muted);font-weight:500;font-size:14px;transition:background .15s,color .15s}
 .navlinks a:hover{background:rgba(19,34,28,.05);color:var(--ink)}
 .navlinks a.active{background:var(--ink);color:#fff}
 .networth{margin-left:auto;text-align:right;line-height:1.15}
 .k{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);font-weight:700}
 .networth .v{font-family:var(--mono);font-weight:600;font-size:15px}
 /* ===== layout ===== */
 main{padding:26px 0 40px}
 .row{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:18px;align-items:start;margin-bottom:18px}
 .c4{grid-column:span 4}
 .c5{grid-column:span 5}
 .c7{grid-column:span 7}
 .c8{grid-column:span 8}
 .c12{grid-column:span 12}
 .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
 .pad{padding:20px}
 /* ===== hero ===== */
 .greeting{display:inline-block;padding:0;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-dark);text-align:left;transition:color .15s}
 .greeting:hover{color:var(--ink)}
 .greeting .greeting-name{text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px;text-decoration-thickness:1px}
 .hero-title{font-family:var(--serif);font-size:clamp(25px,3.4vw,32px);line-height:1.1;margin:10px 0 6px;letter-spacing:-.02em}
 .sub{font-size:13.5px;color:var(--muted)}
 .total{font-family:var(--serif);font-size:clamp(38px,6vw,54px);line-height:1;letter-spacing:-.03em;margin:16px 0 4px}
 .stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:18px;border-top:1px solid var(--line);padding-top:16px}
 .stat .v{font-family:var(--mono);font-weight:600;font-size:15px;margin-top:3px}
 .stat .v.owed{color:var(--danger)}
 .interest{display:flex;align-items:center;gap:10px;margin-top:16px;background:var(--accent-soft);border-radius:12px;padding:12px 14px}
 .interest .v{font-family:var(--mono);font-weight:700}
 .interest .btn{margin-left:auto}
 .quick{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;margin-top:16px}
 /* ===== buttons ===== */
 .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--line-2);border-radius:999px;padding:9px 15px;font-size:14px;font-weight:600;background:var(--surface);transition:transform .12s,background .15s,border-color .15s,box-shadow .15s;white-space:nowrap}
 .btn:hover{transform:translateY(-1px)}
 .btn:active{transform:translateY(0)}
 .btn.primary{background:linear-gradient(150deg,var(--accent),var(--accent-dark));color:#fff;border-color:transparent;box-shadow:0 10px 22px -12px rgba(13,159,110,.95)}
 .btn.danger{background:var(--danger-soft);color:var(--danger);border-color:transparent}
 .btn.ghost{background:transparent;border-color:transparent;color:var(--muted);padding:8px 11px}
 .btn.ghost:hover{background:rgba(19,34,28,.06);color:var(--ink)}
 .btn.small{padding:7px 12px;font-size:12.5px}
 .quick .btn{justify-content:flex-start;padding:13px 14px;background:var(--surface-2);border-color:var(--line);font-weight:600}
 /* ===== section head ===== */
 .section-head{display:flex;align-items:center;gap:12px;margin-bottom:16px}
 .section-head h2{font-size:16px;font-weight:700}
 .section-head .count{font-size:12px;color:var(--muted);font-weight:600}
 .section-head .spacer{flex:1}
 /* ===== accounts ===== */
 .accounts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:14px}
 .account{position:relative;border:1px solid var(--line);border-radius:14px;padding:16px;background:var(--surface-2);overflow:hidden;transition:transform .15s,box-shadow .15s}
 .account:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
 .account::before{content:"";position:absolute;top:0;bottom:0;left:0;width:4px;background:var(--accent)}
 .account.savings::before{background:var(--blue)}
 .acct-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:14px}
 .acct-name{font-weight:700;font-size:13.5px}
 .acct-num{font-family:var(--mono);font-size:11px;color:var(--muted);margin-top:2px}
 .pill{font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent-dark);white-space:nowrap}
 .pill.savings{background:var(--blue-soft);color:var(--blue)}
 .acct-bal{font-family:var(--serif);font-size:27px;letter-spacing:-.02em;line-height:1}
 .acct-interest{font-size:11.5px;color:var(--accent-dark);font-weight:600;margin-top:5px}
 .acct-actions{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap}
 /* ===== virtual cards ===== */
 .vcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(228px,1fr));gap:14px}
 .vcard{position:relative;border-radius:16px;color:#fff;overflow:hidden;box-shadow:var(--shadow);transition:transform .16s;cursor:pointer}
 .vcard:hover{transform:translateY(-3px)}
 .vcard-link{display:flex;flex-direction:column;justify-content:space-between;aspect-ratio:1.6;padding:16px;text-shadow:0 1px 2px rgba(0,0,0,.18)}
 .vc-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
 .vc-nick{font-weight:700;font-size:14px}
 .vc-kind{font-size:10.5px;opacity:.82;margin-top:2px;letter-spacing:.04em}
 .vc-chip{width:30px;height:21px;border-radius:5px;background:linear-gradient(135deg,#f7e7a8,#c9a23f);box-shadow:inset 0 0 0 1px rgba(255,255,255,.35)}
 .vc-num{font-family:var(--mono);font-size:15px;letter-spacing:.1em}
 .vc-bottom{display:flex;justify-content:space-between;align-items:flex-end;font-size:11px;opacity:.9}
 .vc-cancel{position:absolute;right:14px;bottom:14px;background:rgba(255,255,255,.22);color:#fff;border-radius:999px;padding:5px 11px;font-size:11px;font-weight:700;backdrop-filter:blur(4px)}
 .vc-cancel:hover{background:rgba(255,255,255,.36)}
 .vc-canceled{position:absolute;right:14px;bottom:14px;font-size:11px;font-weight:700;opacity:.85}
 .vcard.canceled{filter:grayscale(.8) brightness(.72)}
 /* ===== loans ===== */
 .loans-list{display:grid;gap:12px}
 .loan{display:block;border:1px solid var(--line);border-radius:14px;padding:15px;background:var(--surface-2);transition:transform .15s,box-shadow .15s}
 .loan:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
 .loan-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
 .loan-name{font-weight:700;font-size:14px}
 .loan-meta{font-size:11.5px;color:var(--muted);margin-top:2px}
 .loan-bal{font-family:var(--mono);font-weight:700;font-size:15px}
 .progress{height:8px;border-radius:999px;background:var(--line);overflow:hidden;margin-top:12px}
 .progress > span{display:block;height:100%;background:linear-gradient(90deg,var(--accent),#34c58b)}
 .loan-foot{display:flex;justify-content:space-between;font-size:11.5px;color:var(--muted);margin-top:8px}
 /* ===== friends ===== */
 .friend{display:flex;align-items:center;gap:11px;padding:9px 0;border-bottom:1px solid var(--line)}
 .friend:last-child{border-bottom:none}
 .avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;font-size:13px;flex:none}
 .friend-main{flex:1;min-width:0}
 .friend-name{font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .friend-handle{font-size:11.5px;color:var(--muted)}
 /* ===== activity ===== */
 .activity{display:flex;flex-direction:column}
 .tx{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
 .tx:last-child{border-bottom:none}
 .tx-ico{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:15px;background:var(--surface-2);flex:none}
 .tx-main{flex:1;min-width:0}
 .tx-desc{font-size:13.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .tx-time{font-size:11.5px;color:var(--muted);margin-top:1px}
 .tx-amt{font-family:var(--mono);font-weight:600;font-size:13.5px}
 .tx-amt.pos{color:var(--accent-dark)}
 .empty{border:1px dashed var(--line-2);border-radius:12px;padding:22px;text-align:center;color:var(--muted);font-size:13.5px}
 /* ===== modal ===== */
 .modal{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(19,34,28,.42);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
 .modal.open{display:flex;animation:fade .16s ease}
 @keyframes fade{from{opacity:0}to{opacity:1}}
 .modal-card{width:min(470px,100%);max-height:92vh;overflow:auto;background:var(--surface);border-radius:20px;box-shadow:0 40px 80px -30px rgba(19,34,28,.6);animation:pop .18s cubic-bezier(.2,.8,.2,1)}
 @keyframes pop{from{transform:translateY(12px) scale(.98);opacity:0}to{transform:none;opacity:1}}
 .modal-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;gap:12px;padding:18px 20px;border-bottom:1px solid var(--line);background:var(--surface)}
 .modal-head h3{font-size:16px;font-weight:700}
 .icon-btn{margin-left:auto;width:32px;height:32px;border-radius:10px;border:1px solid var(--line);background:var(--surface-2);font-size:18px;line-height:1;display:grid;place-items:center}
 .modal-body{display:grid;gap:14px;padding:20px}
 .modal-body form{display:grid;gap:14px}
 .field{display:grid;gap:6px}
 .field label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:700}
 .field input,.field select{width:100%;padding:11px 13px;border-radius:11px;border:1px solid var(--line-2);background:var(--surface-2);transition:border-color .15s,box-shadow .15s}
 .field input:focus,.field select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
 .modal-actions{display:flex;gap:10px;justify-content:flex-end;padding:0 20px 20px}
 .modal-actions.inline{padding:0;justify-content:flex-start}
 .detail-hero .detail-big{font-family:var(--serif);font-size:40px;line-height:1;letter-spacing:-.03em;margin:6px 0}
 .detail-actions{display:flex;gap:10px;flex-wrap:wrap}
 .bigcard{border-radius:16px;color:#fff;padding:18px;box-shadow:var(--shadow);text-shadow:0 1px 2px rgba(0,0,0,.18)}
 .bigcard .vc-num{font-size:17px;margin:22px 0}
 .paid-note{background:var(--accent-soft);color:var(--accent-dark);border-radius:12px;padding:12px 14px;font-weight:600;font-size:13.5px}
 .preview{background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-size:13px;color:var(--muted)}
 .preview strong{color:var(--ink);font-family:var(--mono)}
 /* ===== toast / footer ===== */
 .toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(24px);opacity:0;pointer-events:none;z-index:200;background:var(--ink);color:#fff;padding:12px 16px;border-radius:12px;display:flex;align-items:center;gap:16px;box-shadow:0 20px 40px -16px rgba(0,0,0,.6);transition:transform .22s,opacity .22s;max-width:calc(100% - 40px);font-size:13.5px}
 .toast.show{transform:translateX(-50%) translateY(0);opacity:1;pointer-events:auto}
 .toast button{color:#8fe3bf;font-weight:700;font-size:13.5px}
 footer{border-top:1px solid var(--line);padding:22px 0 30px;color:var(--muted);font-size:12.5px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
 footer .spacer{flex:1}
 /* ===== responsive ===== */
 @media(max-width:940px){.row{grid-template-columns:minmax(0,1fr)}.c4,.c5,.c7,.c8,.c12{grid-column:auto}}
 @media(max-width:820px){.navlinks{position:fixed;left:0;right:0;bottom:0;top:auto;z-index:60;margin:0;padding:6px 4px;justify-content:space-around;background:rgba(255,254,251,.97);backdrop-filter:blur(12px);border-top:1px solid var(--line)}.navlinks a{flex:1;text-align:center;padding:7px 2px;font-size:12px}body{padding-bottom:70px}.total{font-size:clamp(34px,10vw,44px)}}
 @media(max-width:520px){.stats{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px}.networth{display:none}}

header
 addClass topbar
 div
  class topbar-inner wrap
  a
   addClass brand
   href #/
   span B
    addClass brand-mark
   span Bank of Breck
  nav
   addClass navlinks
   a Dashboard
    href #/
    data-nav dashboard
   a Accounts
    href #accounts
    data-nav accounts
   a Cards
    href #cards
    data-nav cards
   a Loans
    href #loans
    data-nav loans
   a Friends
    href #friends
    data-nav friends
   a Activity
    href #activity
    data-nav activity
  div
   addClass networth
   span NET WORTH
    addClass k
   strong $0.00
    addClass v
    id net-worth

main
 addClass wrap
 div
  addClass row
  section
   class card pad c5
   id sec-overview
   button Good morning.
    addClass greeting
    id greeting
    data-action edit-name
    title Tell us your name
   h1 Money is just a number.
    addClass hero-title
   p At Bank of Breck, <i>you</i> tell <i>us</i> how much money you have.
    addClass sub
   div $0.00
    addClass total
    id total-balance
   div
    addClass stats
    div
     addClass stat
     span AVAILABLE
      addClass k
     div $0.00
      addClass v
      id stat-available
    div
     addClass stat
     span OWED
      addClass k
     div $0.00
      class v owed
      id stat-owed
    div
     addClass stat
     span ACCOUNTS
      addClass k
     div 0
      addClass v
      id stat-accounts
   div
    addClass interest
    span $0.00
     addClass v
     id interest-pending
    span ready to collect
     addClass muted
    button Collect
     class btn primary small
     data-action interest
   div
    addClass quick
    a New account
     addClass btn
     href #new-account
    a Transfer
     addClass btn
     href #transfer
    a Send money
     addClass btn
     href #send
    a Add money
     addClass btn
     href #deposit
    a Apply for loan
     addClass btn
     href #apply-loan
    a New card
     addClass btn
     href #new-card
  section
   class card pad c7
   id sec-accounts
   div
    addClass section-head
    h2 Accounts
    span 0 accounts
     addClass count
     id accounts-count
    div
     addClass spacer
    a New account
     class btn small
     href #new-account
   div
    addClass accounts-grid
    id accounts-grid
  section
   class card pad c7
   id sec-cards
   div
    addClass section-head
    h2 Virtual cards
    span 0 active
     addClass count
     id cards-count
    div
     addClass spacer
    a New card
     class btn small
     href #new-card
   div
    addClass vcards
    id cards-grid
  section
   class card pad c5
   id sec-loans
   div
    addClass section-head
    h2 Loans
    div
     addClass spacer
    a Apply
     class btn small
     href #apply-loan
   div
    addClass loans-list
    id loans-list
  section
   class card pad c4
   id sec-friends
   div
    addClass section-head
    h2 Friends
   div
    id friends-list
  section
   class card pad c8
   id sec-activity
   div
    addClass section-head
    h2 Activity
    div
     addClass spacer
    button Clear
     class btn ghost small
     data-action clear-activity
   div
    addClass activity
    id activity-list

footer
 addClass wrap
 span Bank of Breck — a front-end-only demo. No real money, no server.
 div
  addClass spacer
 a History file
  class btn ghost small
  href #history
 button Reset demo data
  class btn ghost small
  data-action reset

div
 addClass modal
 id modal-new-account
 data-modal new-account
 div
  addClass modal-card
  div
   addClass modal-head
   h3 Open an account
   button ×
    addClass icon-btn
    data-action close
    aria-label Close
  form
   data-form new-account
   div
    addClass modal-body
    div
     addClass field
     label Account name
      for account-name
     input
      id account-name
      type text
      placeholder e.g. Vacation fund
    div
     addClass field
     label Type
      for account-type
     select
      id account-type
      option Checking
       value checking
      option Savings
       value savings
    div
     addClass field
     label Opening deposit
      for account-opening
     input
      id account-opening
      type number
      min 0
      step 0.01
      value 0
      placeholder 0.00
   div
    addClass modal-actions
    button Cancel
     class btn ghost
     type button
     data-action close
    button Open account
     class btn primary
     type submit

div
 addClass modal
 id modal-transfer
 data-modal transfer
 div
  addClass modal-card
  div
   addClass modal-head
   h3 Transfer money
   button ×
    addClass icon-btn
    data-action close
    aria-label Close
  form
   data-form transfer
   div
    addClass modal-body
    div
     addClass field
     label From
      for transfer-from
     select
      id transfer-from
    div
     addClass field
     label To
      for transfer-to
     select
      id transfer-to
    div
     addClass field
     label Amount
      for transfer-amount
     input
      id transfer-amount
      type number
      min 0.01
      step 0.01
      placeholder 0.00
    div
     addClass field
     label Note
      for transfer-note
     input
      id transfer-note
      type text
      placeholder What is it for?
   div
    addClass modal-actions
    button Cancel
     class btn ghost
     type button
     data-action close
    button Transfer
     class btn primary
     type submit

div
 addClass modal
 id modal-send
 data-modal send
 div
  addClass modal-card
  div
   addClass modal-head
   h3 Send money
   button ×
    addClass icon-btn
    data-action close
    aria-label Close
  form
   data-form send
   div
    addClass modal-body
    div
