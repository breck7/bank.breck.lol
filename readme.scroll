div
 addClass modal
 id modal-deposit
 data-modal deposit
 div
  addClass modal-card
  div
   addClass modal-head
   h3 Add money
   button ×
    addClass icon-btn
    data-action close
    aria-label Close
  form
   data-form deposit
   div
    addClass modal-body
    div
     addClass field
     label Into
      for deposit-account
     select
      id deposit-account
    div
     addClass field
     label Amount
      for deposit-amount
     input
      id deposit-amount
      type number
      min 0.01
      step 0.01
      placeholder 0.00
    p Demo funds. Nothing real moves.
     addClass muted
   div
    addClass modal-actions
    button Cancel
     class btn ghost
     type button
     data-action close
    button Add money
     class btn primary
     type submit

